From 657673c497349a21f2719ff82e65baa80076e594 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 10:55:27 +0100
Subject: [PATCH] Config: only default the affected PG on a version mismatch

A PG version bump or a new PG made readEEPROM() fail, and init() answered
any failure with a full resetEEPROM(), wiping board config too.

Keep the full reset for a bad EEPROM version or board identifier. Otherwise
leave the affected groups on defaults, block arming with REBOOT_REQD and
list them in the CLI until the config is saved.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ShSV4Ltz2bTZ7XNM5TnYWg
---
 src/main/cli/cli.c              | 20 ++++++++++++++++++++
 src/main/config/config_eeprom.c | 32 ++++++++++++++++++++++++++++----
 src/main/config/config_eeprom.h |  6 ++++++
 src/main/fc/init.c              |  7 ++++++-
 4 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/src/main/cli/cli.c b/src/main/cli/cli.c
index 9e4daa1..2719c9c 100644
--- a/src/main/cli/cli.c
+++ b/src/main/cli/cli.c
@@ -4948,6 +4948,22 @@ static const char *getMcuTypeById(mcuTypeId_e id)
     }
 }
 
+static void cliPrintDefaultedPgWarning(void)
+{
+    const uint16_t count = getEEPROMDefaultedPgCount();
+    if (count == 0) {
+        return;
+    }
+
+    cliPrintLinef("###WARNING: %d PARAMETER GROUP(S) COULD NOT BE RESTORED AND ARE ON DEFAULTS###", count);
+    cliPrint("PGN:");
+    for (uint16_t i = 0; i < MIN(count, EEPROM_MAX_REPORTED_DEFAULTED_PGS); i++) {
+        cliPrintf(" %d", getEEPROMDefaultedPgn(i));
+    }
+    cliPrintLinefeed();
+    cliPrintLine("ARMING IS BLOCKED (REBOOT_REQD). RE-APPLY YOUR SETTINGS, THEN SAVE.");
+}
+
 static void cliStatus(const char *cmdName, char *cmdline)
 {
     UNUSED(cmdName);
@@ -5128,6 +5144,8 @@ if (buildKey) {
         cliPrintf(" %s", armingDisableFlagNames[bitpos]);
     }
     cliPrintLinefeed();
+
+    cliPrintDefaultedPgWarning();
 }
 
 static void cliTasks(const char *cmdName, char *cmdline)
@@ -7169,6 +7187,8 @@ void cliEnter(serialPort_t *serialPort)
 #endif
     //setArmingDisabled(ARMING_DISABLED_CLI); // tblaha: highway to the dangerzone TODO
 
+    cliPrintDefaultedPgWarning();
+
     cliPrompt();
 
 #ifdef USE_CLI_BATCH
diff --git a/src/main/config/config_eeprom.c b/src/main/config/config_eeprom.c
index 1e166ca..d1c024b 100644
--- a/src/main/config/config_eeprom.c
+++ b/src/main/config/config_eeprom.c
@@ -418,6 +418,19 @@ static const configRecord_t *findEEPROM(const pgRegistry_t *reg, configRecordFla
     return NULL;
 }
 
+static uint16_t defaultedPgCount = 0;
+static uint16_t defaultedPgns[EEPROM_MAX_REPORTED_DEFAULTED_PGS];
+
+uint16_t getEEPROMDefaultedPgCount(void)
+{
+    return defaultedPgCount;
+}
+
+uint16_t getEEPROMDefaultedPgn(uint16_t index)
+{
+    return (index < EEPROM_MAX_REPORTED_DEFAULTED_PGS) ? defaultedPgns[index] : 0;
+}
+
 // Initialize all PG records from EEPROM.
 // This functions processes all PGs sequentially, scanning EEPROM for each one. This is suboptimal,
 //   but each PG is loaded/initialized exactly once and in defined order.
@@ -425,19 +438,29 @@ bool loadEEPROM(void)
 {
     bool success = true;
 
+    defaultedPgCount = 0;
+
     PG_FOREACH(reg) {
         const configRecord_t *rec = findEEPROM(reg, CR_CLASSICATION_SYSTEM);
+        bool loaded = false;
         if (rec) {
             // config from EEPROM is available, use it to initialize PG. pgLoad will handle version mismatch
-            if (!pgLoad(reg, rec->pg, rec->size - offsetof(configRecord_t, pg), rec->version)) {
-                success = false;
-            }
+            loaded = pgLoad(reg, rec->pg, rec->size - offsetof(configRecord_t, pg), rec->version);
         } else {
             pgReset(reg);
+        }
+        *reg->fnv_hash = fnv_update(FNV_OFFSET_BASIS, reg->address, pgSize(reg));
 
+        if (!loaded) {
             success = false;
+            if (defaultedPgCount < EEPROM_MAX_REPORTED_DEFAULTED_PGS) {
+                defaultedPgns[defaultedPgCount] = pgN(reg);
+            }
+            defaultedPgCount++;
+            // The stored record is stale even if the values are never changed,
+            // so the next save has to write it, or this group never recovers.
+            *reg->fnv_hash = ~(*reg->fnv_hash);
         }
-        *reg->fnv_hash = fnv_update(FNV_OFFSET_BASIS, reg->address, pgSize(reg));
     }
 
     return success;
@@ -525,6 +548,7 @@ void writeConfigToEEPROM(void)
 
 
     if (success && isEEPROMVersionValid() && isEEPROMStructureValid()) {
+        defaultedPgCount = 0;
         return;
     }
 
diff --git a/src/main/config/config_eeprom.h b/src/main/config/config_eeprom.h
index 8f751e2..c94cf35 100644
--- a/src/main/config/config_eeprom.h
+++ b/src/main/config/config_eeprom.h
@@ -30,5 +30,11 @@ bool isEEPROMStructureValid(void);
 bool loadEEPROM(void);
 void writeConfigToEEPROM(void);
 
+// Parameter groups that the last loadEEPROM() could not restore (stored version
+// mismatch, or no stored record), so they run on defaults. Cleared by a save.
+#define EEPROM_MAX_REPORTED_DEFAULTED_PGS 16
+uint16_t getEEPROMDefaultedPgCount(void);
+uint16_t getEEPROMDefaultedPgn(uint16_t index); // index < EEPROM_MAX_REPORTED_DEFAULTED_PGS
+
 uint16_t getEEPROMConfigSize(void);
 size_t getEEPROMStorageSize(void);
diff --git a/src/main/fc/init.c b/src/main/fc/init.c
index bbf9eef..da9f8a1 100644
--- a/src/main/fc/init.c
+++ b/src/main/fc/init.c
@@ -425,8 +425,13 @@ void init(void)
     initBoardInformation();
 #endif
 
-    if (!readSuccess || !isEEPROMVersionValid() || strncasecmp(systemConfig()->boardIdentifier, TARGET_BOARD_IDENTIFIER, sizeof(TARGET_BOARD_IDENTIFIER))) {
+    if (!isEEPROMVersionValid() || strncasecmp(systemConfig()->boardIdentifier, TARGET_BOARD_IDENTIFIER, sizeof(TARGET_BOARD_IDENTIFIER))) {
         resetEEPROM(false);
+    } else if (!readSuccess) {
+        // Only some parameter groups fell back to defaults (PG version bump, or a
+        // new group). Keep everything else, but do not allow arming until the
+        // config has been checked, saved and the board rebooted.
+        setRebootRequired();
     }
 
     systemState |= SYSTEM_STATE_CONFIG_LOADED;
-- 
